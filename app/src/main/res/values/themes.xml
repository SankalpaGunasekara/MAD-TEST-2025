<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Test" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- Other theme attributes -->

        <!-- Make status bar transparent -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Make navigation bar transparent -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- This makes the status bar icons (time, battery) dark. Use "false" for light icons on a dark background. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Test" parent="Base.Theme.Test" />

    <style name="ShapeAppearance.App.CustomCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">40dp</item>
        <item name="cornerSizeTopRight">40dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="BottomNavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#757575</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:backgroundTint">#EFEBE9</item>
    </style>

    <style name="StarIcon">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:src">@drawable/ic_star</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#757575</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>