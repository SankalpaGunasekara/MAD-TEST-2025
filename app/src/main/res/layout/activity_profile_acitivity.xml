<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileAcitivity">

    <!-- Background Image -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_big_blur"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <!-- Page Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Your Profiles"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Profile Type Tabs -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#FCE4EC"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Customer Profile Tab (Active) -->
                    <TextView
                        android:id="@+id/tabCustomerProfile"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/tab_active_background_new"
                        android:gravity="center"
                        android:text="Customer"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Worker Profile Tab (Inactive) -->
                    <TextView
                        android:id="@+id/tabWorkerProfile"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Work"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Your Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Name"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Kasun Kavindu"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- Username Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="Kasun1234"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- Contact Number Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="0112456654"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <!-- Email Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="kasun@gmail.com"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_nav_background_new"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/home_nav"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:drawableTop="@drawable/ic_home_new"
            android:text="Home" />

        <Button
            android:id="@+id/navBookings"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:drawableTop="@drawable/ic_bookings_new"
            android:text="Bookings" />

        <Button
            android:id="@+id/navTips"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:drawableTop="@drawable/ic_tips_new"
            android:text="Tips" />

        <Button
            android:id="@+id/nav_Profile"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#FAE5E5"
            android:drawableTop="@drawable/ic_profile_new"
            android:text="Profile"
            android:textColor="#E57373" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>