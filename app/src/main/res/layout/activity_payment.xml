<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_blue"
    tools:context=".PaymentActivity">

    <!-- Status Bar -->
    <View
        android:id="@+id/status_bar"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="@color/primary_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header with back button and title -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <!-- Card Number Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Number:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_card_number"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_background"
                android:hint="1234 5678 9012 3456"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="number"
                android:maxLength="19"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="24dp" />

            <!-- Card Holder Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Holder Name:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_card_holder_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_background"
                android:hint="John Doe"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="textPersonName"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="24dp" />

            <!-- Expiry Date Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiry date:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_expiry_date"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_field_background"
                android:hint="MM/YY"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="number"
                android:maxLength="5"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="24dp" />

            <!-- CVV Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CVV:"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_cvv"
                android:layout_width="120dp"
                android:layout_height="50dp"
                android:background="@drawable/input_field_background"
                android:hint="123"
                android:textColorHint="@color/hint_gray"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:fontFamily="@font/inter_regular"
                android:layout_marginBottom="48dp" />

            <!-- Pay Now Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_pay_now"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                app:cardCornerRadius="25dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/input_focused"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginBottom="32dp">

                <Button
                    android:id="@+id/paynowbtn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/input_focused"
                    android:gravity="center"
                    android:text="Pay Now"
                    android:textColor="@color/input_background"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_home_filled"
                app:tint="@color/light_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/light_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBookings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_bookings"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_tips"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tips"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="4dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>