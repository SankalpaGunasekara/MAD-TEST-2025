<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF7"
    tools:context=".PaymentActivity">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_big_blur"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header with back button -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@android:color/black" />

    </LinearLayout>

    <!-- Page Title -->
    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finalize your booking"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        android:layout_marginTop="8dp"/>

    <!-- Main Content Area -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/page_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Card Number Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Number :"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_card_number"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:hint="1230 4560 7890 9632"
                android:textColorHint="#BDBDBD"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="number"
                android:maxLength="19"
                android:layout_marginBottom="24dp" />

            <!-- Card Holder Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Card Holder Name :"
                android:textColor="#424242"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_card_holder_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_field_light_background"
                android:hint="Kasun Kavindu"
                android:textColorHint="#BDBDBD"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:paddingHorizontal="16dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="24dp" />

            <!-- Expiry and CVV Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Expiry Date Field -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expiry date :"
                        android:textColor="#424242"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_expiry_date"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/input_field_light_background"
                        android:hint="YYYY/MM/DD"
                        android:textColorHint="#BDBDBD"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:paddingHorizontal="16dp"
                        android:inputType="date" />
                </LinearLayout>

                <!-- CVV Field -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CVV :"
                        android:textColor="#424242"
                        android:textSize="16sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/et_cvv"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/input_field_light_background"
                        android:hint="789"
                        android:textColorHint="#BDBDBD"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:inputType="numberPassword"
                        android:maxLength="4" />
                </LinearLayout>

            </LinearLayout>

            <!-- Proceed Button (replaces CardView) -->
            <Button
                android:id="@+id/paynowbtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#F57C00"
                android:text="Proceed"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:cornerRadius="30dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation (As requested, this part is NOT changed) -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_nav_background_new"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/home_nav"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="#FAE5E5"
            android:drawableTop="@drawable/ic_home_new"
            android:textColor="#E57373" />

        <Button
            android:id="@+id/navBookings"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:drawableTop="@drawable/ic_bookings_new" />

        <Button
            android:id="@+id/navTips"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:drawableTop="@drawable/ic_tips_new" />

        <Button
            android:id="@+id/nav_Profile"
            style="@style/BottomNavButton"
            android:layout_height="50dp"
            android:drawableTop="@drawable/ic_profile_new" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>