<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Onboard2Activity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/primary_blue"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Status Bar Space -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Status Bar Mock -->

        <!-- Welcome Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:text="Choose Your Need"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Character Illustration Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">


            <!-- Character Image -->
            <ImageView
                android:id="@+id/characterImage"
                android:layout_width="match_parent"
                android:layout_height="389dp"
                android:layout_gravity="center"
                android:contentDescription="wide range of services"
                android:src="@drawable/onboard2_image" />

        </FrameLayout>

        <!-- Subtitle Text -->
        <TextView
            android:layout_width="374dp"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="4dp"
            android:text="Book reliable home services\nin seconds"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="Choose from a wide range  of services" />

        <!-- Page Indicator Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_background_gray" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_next_background" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/button_background_gray" />

        </LinearLayout>

        <!-- Next Button -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/btnclr"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/primary_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>